# Copy to .env for local backend (never commit .env)
# Full Oura + migration steps: ../OURA_BACKEND_SETUP.md

# Oura OAuth (checked first). Set both on the server host.
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=

# If OURA_* are unset, backend loads oura_client_id / oura_client_secret from
# public.server_integration_secrets (requires migration + rows in Supabase).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
